# Bundled legal texts and generated assets are packaged from the working tree; keep their line
# endings identical on Windows and CI so a release APK does not differ by build platform.
LICENSE text eol=lf
THIRD_PARTY_NOTICES.md text eol=lf
app/src/main/assets/**/*.json text eol=lf
app/src/main/assets/**/*.md text eol=lf
app/src/main/res/raw*/*.md text eol=lf
app/src/main/res/raw*/*.xml text eol=lf

# Generated launcher XML is compared byte for byte by the icon generator.
app/src/main/res/**/ic_launcher_system*.xml text eol=lf
app/src/main/res/**/ic_launcher_background*.xml text eol=lf
app/src/main/res/raw/keep_plugin_center_icon.xml text eol=lf

# Icon Studio reproducible assets
.icons/assets/** binary
.icons/recipe.json text eol=lf
.python/icon_studio_runtime.py text eol=lf
.python/generate_icon_studio.py text eol=lf
app/src/main/res/raw/keep_icon_studio.xml text eol=lf
app/src/main/res/raw/keep_icon_studio_background.xml text eol=lf
app/src/main/res/values*/icon_studio_backgrounds.xml text eol=lf
