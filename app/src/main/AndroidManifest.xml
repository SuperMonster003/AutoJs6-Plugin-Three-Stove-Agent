<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="org.autojs.autojs6" />
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
        <intent><action android:name="org.autojs.plugin.SPEECH" /></intent>
        <intent><action android:name="org.autojs.plugin.speech.action.RESIDENT_LISTENER" /></intent>
    </queries>

    <!--
        Update checks and explicitly configured MCP tools use the network (roadmap P10).
        Model traffic and built-in device actions go through AutoJs6 over Binder. Local network
        access is requested from MCP settings on Android 17+. Foreground-service and notification
        permissions keep active tasks and the resident listener visible. Overlay permission is requested
        only from settings. The boot permission only posts "tap to resume" for an enabled resident
        listener (roadmap D67); 3-Macaw Speech records, never this plugin.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_icon_studio_application"
        android:roundIcon="@mipmap/ic_icon_studio_application"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThreeStoveAgent"
        tools:targetApi="33">

        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="0" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />
        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Standalone task workbench. -->
        <activity
            android:name=".ui.LauncherActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias android:name=".launcher.AdaptiveLightIconAlias" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_system_light" android:targetActivity=".ui.LauncherActivity">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.AdaptiveDarkIconAlias" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_system" android:targetActivity=".ui.LauncherActivity">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.AdaptiveAutoIconAlias" android:enabled="true" android:exported="true"
            android:icon="@mipmap/ic_launcher_system_auto" android:targetActivity=".ui.LauncherActivity">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.TransparentIconAlias" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher" android:targetActivity=".ui.LauncherActivity">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity android:name=".ui.ShareTargetActivity" android:exported="true" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!--
            Target of the 3-Macaw Speech digital assistant (roadmap D60, D78): like the share entry it only opens a
            reviewable draft. It runs next to the floating ball and borrows the application label and icon, which the
            assistant shows on its target button.
        -->
        <activity android:name=".ui.VoiceCommandActivity" android:exported="true" android:excludeFromRecents="true"
            android:noHistory="true" android:process=":agent" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.VoiceInputActivity" android:exported="false" android:excludeFromRecents="true"
            android:theme="@style/Theme.ThreeStoveAgent.Dialog.Light" />

        <activity android:name=".ui.ScriptRootsActivity" android:exported="false" />
        <activity android:name=".ui.RunDetailActivity" android:exported="false" />
        <activity android:name=".ui.HistoryActivity" android:exported="false" />
        <activity android:name=".ui.PresetsActivity" android:exported="false" />
        <activity android:name=".ui.MemoryActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <!--
            "Open 3-Stove Agent settings" for the other resident listeners (roadmap D73, 3-Stone AI D31): the settings
            screen itself stays private; this alias opens it at the resident listener rows.
        -->
        <activity-alias android:name=".speech.ResidentListenerSettings" android:exported="true"
            android:permission="org.autojs.permission.PLUGIN" android:targetActivity=".ui.SettingsActivity" />
        <activity android:name=".ui.McpServersActivity" android:exported="false" />
        <activity android:name=".ui.RiskRecognitionActivity" android:exported="false" />
        <activity android:name=".ui.ReleaseHistoryActivity" android:exported="false" />
        <activity android:name=".ui.AboutActivity" android:exported="false" />
        <activity android:name=".ui.ConfirmationActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity=""
            android:theme="@style/Theme.ThreeStoveAgent.Dialog.Light" />
        <activity android:name=".ui.FailureAlertActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity=""
            android:theme="@style/Theme.ThreeStoveAgent.Dialog.Light" />

        <service
            android:name=".ThreeStoveAgentTaskForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":agent">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated, bounded Agent tasks using the AutoJs6 host; keeps progress, confirmation and stop controls available until task completion." />
        </service>

        <!--
            Resident listener (roadmap D66, D73): enabled exactly while the user has it on, which is how 3-Stone AI and
            3-Macaw Speech see that this plugin listens (3-Stone AI D31). Exported for that query only and protected by
            the plugin permission. It holds the wake session of 3-Macaw Speech, which records.
        -->
        <service
            android:name=".speech.ResidentListenerService"
            android:enabled="false"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":agent">
            <intent-filter>
                <action android:name="org.autojs.plugin.speech.action.RESIDENT_LISTENER" />
            </intent-filter>
            <meta-data
                android:name="org.autojs.plugin.speech.RESIDENT_LISTENER_SETTINGS"
                android:value="io.github.supermonster003.autojs6.plugin.three.stove.agent.speech.ResidentListenerSettings" />
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled resident wake word listener: holds the wake session of the 3-Macaw Speech plugin, which records, and turns the sentence after the wake word into a reviewable task draft." />
        </service>

        <service
            android:name=".service.AgentLocalService"
            android:exported="false"
            android:process=":agent" />

        <service
            android:name=".ThreeStoveAgentPluginInfoService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="three-stove-agent" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="5298" />
        </service>

        <!--
            Host-facing control plane (roadmap D14 / D15): the agent loop, the task queue and the
            task foreground service all live in the :agent process next to this service.
        -->
        <service
            android:name=".ThreeStoveAgentPluginService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":agent">
            <intent-filter>
                <action android:name="org.autojs.plugin.THREE_STOVE_AGENT" />
                <category android:name="three-stove-agent" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="5298" />
        </service>

        <receiver android:name=".ui.LauncherIconUpdateReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <receiver android:name=".speech.ResidentResumeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
