<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="org.autojs.autojs6" />
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
    </queries>

    <!--
        The plugin never talks to the network on its own (roadmap D28): model traffic and device
        actions go through the AutoJs6 host over Binder. Foreground-service and notification
        permissions keep active tasks visible. Overlay permission remains in P6.7.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiAgent"
        tools:targetApi="33">

        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="0" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />
        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Standalone task workbench. -->
        <activity
            android:name=".ui.LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.ScriptRootsActivity" android:exported="false" />
        <activity android:name=".ui.RunDetailActivity" android:exported="false" />
        <activity android:name=".ui.HistoryActivity" android:exported="false" />
        <activity android:name=".ui.PresetsActivity" android:exported="false" />
        <activity android:name=".ui.MemoryActivity" android:exported="false" />
        <activity android:name=".ui.ConfirmationActivity" android:exported="false" android:excludeFromRecents="true"
            android:theme="@style/Theme.AiAgent.Dialog.Light" />

        <service
            android:name=".AiAgentTaskForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":agent">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated, bounded Agent tasks using the AutoJs6 host; keeps progress, confirmation and stop controls available until task completion." />
        </service>

        <service
            android:name=".service.AgentLocalService"
            android:exported="false"
            android:process=":agent" />

        <service
            android:name=".AiAgentPluginInfoService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="ai-agent" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="5289" />
        </service>

        <!--
            Host-facing control plane (roadmap D14 / D15): the agent loop, the task queue and the
            task foreground service all live in the :agent process next to this service.
        -->
        <service
            android:name=".AiAgentPluginService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":agent">
            <intent-filter>
                <action android:name="org.autojs.plugin.AI_AGENT" />
                <category android:name="ai-agent" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="5289" />
        </service>

    </application>

</manifest>
