<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 themes (roadmap D45). The host snapshot wraps the resource context; screens pick
         Light or Dark explicitly and the runtime palette tints controls with the chosen theme color. -->
    <style name="Base.Theme.ThreeStoveAgent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorOnSurface">@color/text_color_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_color_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/status_danger</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
    <style name="Theme.ThreeStoveAgent" parent="Base.Theme.ThreeStoveAgent">
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Explicit aliases for setTheme: HostAppearanceActivity and the :agent overlay force night mode on the
         AppCompat delegate, so night resources apply through the base theme and the aliases stay empty. -->
    <style name="Theme.ThreeStoveAgent.Light" parent="Base.Theme.ThreeStoveAgent" />
    <style name="Theme.ThreeStoveAgent.Dark" parent="Base.Theme.ThreeStoveAgent" />
    <style name="Theme.ThreeStoveAgent.Dialog.Light" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorOnSurface">@color/text_color_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_color_secondary</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">95%</item>
    </style>
    <style name="Theme.ThreeStoveAgent.Dialog.Dark" parent="Theme.ThreeStoveAgent.Dialog.Light" />

    <style name="AppToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="AppToolbarSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
    </style>
</resources>
