    {
      "name": "ui_dump",
      "group": "observe",
      "risk": "READ_ONLY",
      "description": {
        "en": "Observe the current accessibility tree before choosing an action.",
        "zh": "在选择动作前观察当前无障碍节点树."
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "maxNodes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 400,
            "default": 200
          },
          "maxDepth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32,
            "default": 32
          },
          "visibleOnly": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputHint": "compact text with snapshotId and bounded text/state changes; partial changes describe only the observed subset",
      "bridgeMapping": [
        "accessibility.dump"
      ],
      "defaultEnabled": true,
      "readOnlyHint": true,
      "destructiveHint": false
    },
